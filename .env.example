# Gateway
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/starnose

# 代理（可选，LLM 请求走代理，如 Clash：HTTPS_PROXY=http://192.168.101.66:7890）
# HTTPS_PROXY=

# OpenRouter（多场景可配置不同模型，未配置时使用 OPENROUTER_MODEL）
OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL=openai/gpt-4.1-mini
# 生成规则关键字场景
OPENROUTER_MODEL_KEYWORDS=
# 内容校验/LLM 比较场景
OPENROUTER_MODEL_VALIDATE=
