{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@api-model/*": ["api_model/src/*"],
      "@gateway/*": ["gateway/src/*"],
      "@agents/*": ["Agents/src/*"]
    }
  }
}
